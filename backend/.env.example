# Copy to backend/.env and fill in. NEVER commit the real .env file.
APP_ENV=development

# --- Secrets -------------------------------------------------------------
# AES-256-GCM key: base64 of 32 random bytes. Generate with:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# In development, if left empty, a key is generated into backend/.keys/ (outside the DB).
ENCRYPTION_KEY=
# HMAC key for CSRF tokens (same generation command).
SECRET_KEY=

# --- Groq (optional; without it, local extraction/answering is used) -------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_TIMEOUT_SECONDS=45
# For reasoning models (e.g. Qwen3) set to "hidden" so <think> text is not returned
GROQ_REASONING_FORMAT=

# --- Sessions / cookies ---------------------------------------------------
SESSION_TTL_MINUTES=480
# Must be true when served over HTTPS (required when APP_ENV=production)
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_MB=10
MAX_PAGES=50

# --- Database --------------------------------------------------------------
# DATABASE_URL=sqlite:///./securedoc.db
POLICY_VERSION=1.1
# Extra categories to mask besides the always-masked IDs/bank/card/secrets.
# Default: phone + email. Add PERSON,ADDRESS,DOB,APP_REF to also mask names, addresses, birth dates, references.
MASK_CATEGORIES=PHONE,EMAIL

# Per-request output cap: must not exceed the Groq account's output-tokens-per-minute limit (1000 on the current tier)
GROQ_MAX_OUTPUT_TOKENS=1000

# Chatbot model (separate Groq quota from GROQ_MODEL). Empty = use GROQ_MODEL.
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_CHAT_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_CHAT_REASONING_EFFORT=low
